APP_NAME="AutoCare"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Railway production (set in dashboard Variables before deploy):
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY=base64:...  (php artisan key:generate --show) — required at runtime
# APP_URL=https://your-service.up.railway.app
# LOG_CHANNEL=stderr
# NIXPACKS_PHP_ROOT_DIR=/app/public
# NIXPACKS_NODE_VERSION=22  (also set in nixpacks.toml; needed for Vite 8 build)
# DB_CONNECTION=mysql
# DB_URL: full mysql:// DSN — get from Railway CLI (MySQL service, do not commit real values):
#   railway link   # project + MySQL / app service context
#   railway variable list -s MySQL --kv
# Use MYSQL_PUBLIC_URL value for DB_URL when internal mysql.railway.internal is unreliable.
# Or use dashboard variable references (no literal password in repo).
# MySQL 8 + non-SSL (Railway internal): true fixes caching_sha2_password / SQLSTATE[HY000] [2054]
# MYSQL_GET_SERVER_PUBLIC_KEY=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# LOG_CHANNEL=stderr
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite (default): create the file with `touch database/database.sqlite` then `php artisan migrate`
DB_CONNECTION=sqlite
# DB_DATABASE is optional; defaults to database/database.sqlite (see config/database.php)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
